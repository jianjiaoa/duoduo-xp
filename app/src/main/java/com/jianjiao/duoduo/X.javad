public class XposedInit implements IXposedHookLoadPackage {
    private static final MediaType reqhead = MediaType.parse("application/json; charset=utf-8");
    private final OkHttpClient client = new OkHttpClient();

    ClassLoader classLoader;
    private Context context;
    private Handler mainHandler;
    String ACTIONR = "com.jianjiao.test.PDDGUANGBO";

    private String TAG ="jianjiaoxp";
    public void uploadData(String data) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    RequestBody body = RequestBody.create(reqhead, data);
                    Request request = new Request.Builder().url("http://69.165.65.243:9996/d/upload").post(body).build();
                    Response response = client.newCall(request).execute();
                    try {
                        String str=response.body().string();
                        XposedBridge.log("上传响应: " + str);
                        showToast(str);
                        if (response != null) {
                            response.close();
                        }
                    } finally {
                    }
                } catch (IOException e) {
                    XposedBridge.log("上传失败: " + e.getMessage());
                }
            }
        }).start();
    }

    public void showToast(final String message) {
        if (this.mainHandler == null) {
            try {
                this.mainHandler = new Handler(Looper.getMainLooper());
            } catch (Exception e) {
                XposedBridge.log("创建Handler失败: " + e.getMessage());
                return;
            }
        }
        this.mainHandler.post(new Runnable() {
            @Override
            public final void run() {
                try {
                    if (context != null) {
                        Toast.makeText(context, message, 0).show();
                    } else {
                        XposedBridge.log("Context为空，无法显示Toast: " + message);
                    }
                } catch (Exception e) {
                    XposedBridge.log("显示Toast失败: " + e.getMessage());
                }

            }
        });
    }

    @Override // de.robv.android.xposed.IXposedHookLoadPackage
    public void handleLoadPackage(XC_LoadPackage.LoadPackageParam lpparam) throws Throwable {
        this.classLoader = lpparam.classLoader;
        if (!"com.xunmeng.pinduoduo".equals(lpparam.packageName)) {
            return;
        }
        try {
            Class<?> activityThreadClass = XposedHelpers.findClass("android.app.ActivityThread", null);
            Object currentActivityThread = XposedHelpers.callStaticMethod(activityThreadClass, "currentActivityThread", new Object[0]);
            Object app = XposedHelpers.callMethod(currentActivityThread, "getApplication", new Object[0]);
            this.context = (Context) app;
            XposedBridge.log("成功获取ApplicationContext+" + this.context);
        } catch (Exception e) {
            XposedBridge.log("获取ApplicationContext失败: " + e.getMessage());
        }
        XposedHelpers.findAndHookMethod("com.xunmeng.pinduoduo.ui.activity.HomeActivity", lpparam.classLoader, "onStart", new XC_MethodHook() { // from class: com.jianjiao.duoduo.jj.1
            @Override // de.robv.android.xposed.XC_MethodHook
            protected void afterHookedMethod(XC_MethodHook.MethodHookParam param) throws Throwable {
                super.afterHookedMethod(param);
                XposedInit.this.context = (Context) param.thisObject;
                XposedBridge.log("HomeActivity：" + XposedInit.this.context);
                Log.d(TAG, "多多插件加载成功: ");
                XposedInit.this.showToast("插件已加载666");
            }
        });
        XposedHelpers.findAndHookMethod("com.aimi.android.common.http.HttpCall$Builder", lpparam.classLoader, "params", String.class, new XC_MethodHook() { // from class: com.jianjiao.duoduo.jj.2
            @Override // de.robv.android.xposed.XC_MethodHook
            protected void beforeHookedMethod(XC_MethodHook.MethodHookParam param) throws Throwable {
                super.beforeHookedMethod(param);
            }
        });
        Class GsonClass = lpparam.classLoader.loadClass("com.google.gson.Gson");
        final Object gsonClass = XposedHelpers.newInstance(GsonClass, new Object[0]);
        Class<?> IntegrationRenderResponse = XposedHelpers.findClass("com.xunmeng.pinduoduo.goods.entity.IntegrationRenderResponse", lpparam.classLoader);
        XposedHelpers.findAndHookMethod("com.xunmeng.pinduoduo.goods.entity.GoodsResponse", lpparam.classLoader, "setRenderResponse", IntegrationRenderResponse, new XC_MethodHook() { // from class: com.jianjiao.duoduo.jj.3
            @Override // de.robv.android.xposed.XC_MethodHook
            public void beforeHookedMethod(XC_MethodHook.MethodHookParam param) throws Throwable {
                super.beforeHookedMethod(param);
                Object renderResponse = param.args[0];
                String str = (String) XposedHelpers.callMethod(gsonClass, "toJson", renderResponse);
                XposedBridge.log("____获取渲染数据222:" + str);
                XposedInit.this.showToast("获取到数据："+str.length());
                uploadData(str);
            }
        });
    }

    public void sendintent(){
        Intent intent = new Intent();
        intent.setAction(this.ACTIONR);
        intent.putExtra("code", 111);
        context.sendBroadcast(intent);
        Log.d(TAG, "sendintent: ");
